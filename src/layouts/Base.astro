---
import '../styles/global.css';
import Mark from '../components/Mark.astro';
interface Props {
  title: string;
  description: string;
  lang?: 'ro' | 'en';
  /** URL of this page in the other language, when it exists */
  alt?: string;
  /** Show the "not investment advice" note in the footer */
  disclaimer?: boolean;
  type?: 'website' | 'article';
}
const { title, description, lang = 'en', alt, disclaimer = false, type = 'website' } = Astro.props;
const t = lang === 'ro'
  ? { home: '/ro/', work: 'Proiecte', writing: 'Articole', contact: 'Contact', other: 'English', otherHref: alt ?? '/', theme: 'Schimbă tema (luminos / întunecat)', disclaimer: 'Analizele de aici sunt reconstituiri istorice, nu recomandări de investiții.' }
  : { home: '/', work: 'Work', writing: 'Writing', contact: 'Contact', other: 'Română', otherHref: alt ?? '/ro/', theme: 'Switch theme (light / dark)', disclaimer: 'Everything here is historical reconstruction, not investment advice.' };
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title="Vlad Griguta" href="/rss.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content={type} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <script is:inline>
    // Apply a saved theme before first paint; with nothing saved the system setting decides.
    try { var t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600&display=swap" />
</head>
<body>
  <div class="wrap">
    <header class="site-head">
      <a class="name" href={t.home}><Mark size={24} /><span>Vlad Griguta</span></a>
      <nav aria-label={lang === 'ro' ? 'Principal' : 'Main'}>
        <a href={`${t.home}#work`}>{t.work}</a>
        <a href={`${t.home}#writing`}>{t.writing}</a>
        <a href={`${t.home}#contact`}>{t.contact}</a>
        <a href={t.otherHref} hreflang={lang === 'ro' ? 'en' : 'ro'} lang={lang === 'ro' ? 'en' : 'ro'}>{t.other}</a>
        <button class="theme-toggle" type="button" aria-label={t.theme} title={t.theme}>
          <svg class="sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
        </button>
      </nav>
    </header>
    <slot />
    <footer class="site-foot">
      {disclaimer && <span class="disclaimer">{t.disclaimer}</span>}
      <span>© {new Date().getFullYear()} Vlad Griguta</span>
      <span class="foot-links">
        <a href="https://www.linkedin.com/in/vlad-marius-griguta">LinkedIn</a>
        <a href="https://github.com/vladGriguta">GitHub</a>
        <a href="/rss.xml">RSS</a>
      </span>
    </footer>
  </div>
  <script is:inline>
    // The saved choice is only an override. Switching back to what the system uses clears it,
    // so the site follows the system setting again.
    document.querySelector('.theme-toggle').addEventListener('click', function () {
      var root = document.documentElement;
      var system = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      var next = (root.dataset.theme || system) === 'dark' ? 'light' : 'dark';
      try {
        if (next === system) { delete root.dataset.theme; localStorage.removeItem('theme'); }
        else { root.dataset.theme = next; localStorage.setItem('theme', next); }
      } catch (e) { root.dataset.theme = next; }
    });
  </script>
</body>
</html>
