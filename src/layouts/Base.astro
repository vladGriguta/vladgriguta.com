---
import '../styles/global.css';
interface Props { title: string; description: string; lang?: 'ro' | 'en'; alt?: string; }
const { title, description, lang = 'ro', alt } = Astro.props;
const t = lang === 'ro'
  ? { home: '/', posts: 'Articole', other: 'English', otherHref: alt ?? '/en/', disclaimer: 'Analizele de aici sunt reconstituiri istorice, nu recomandări de investiții.' }
  : { home: '/en/', posts: 'Articles', other: 'Română', otherHref: alt ?? '/', disclaimer: 'Everything here is historical reconstruction, not investment advice.' };
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="application/rss+xml" title="Vlad Griguta" href="/rss.xml" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Sans+Condensed:wght@500;600&display=swap" />
</head>
<body>
  <div class="wrap">
    <header class="site-head">
      <a class="name" href={t.home}>Vlad Griguta</a>
      <nav>
        <a href={t.home}>{t.posts}</a>
        <a href={t.otherHref} hreflang={lang === 'ro' ? 'en' : 'ro'}>{t.other}</a>
      </nav>
    </header>
    <slot />
    <footer class="site-foot">
      <span>{t.disclaimer}</span>
      <span>© {new Date().getFullYear()} Vlad Griguta</span>
    </footer>
  </div>
</body>
</html>
