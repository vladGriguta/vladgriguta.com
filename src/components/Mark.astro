---
// The brand mark: a quiet baseline with one point off it (the anomaly), on an ink tile.
interface Props { size?: number }
const { size = 24 } = Astro.props;
---
<svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="7" fill="#0b0b0b" />
  <polyline points="4,19 8,17.5 12,20 16,18 19,19.5 22,8 25,19 28,17.5" fill="none" stroke="#f9f9f7" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" />
  <circle cx="22" cy="8" r="3.4" fill="#eb6834" />
</svg>
