---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('posts', (p) => p.data.lang === 'en' && !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const fmt = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
---
<Base title="Vlad Griguta" description="Short, data-driven pieces with interactive charts on long-term investing and models." lang="en">
  <main class="col" style="padding-top:56px">
    <h1>Fewer words, more data.</h1>
    <p class="lede">I'm Vlad, an ML/AI consultant. This is where I publish the analyses I do for myself, charts and method included.</p>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={`/en/${p.id.split('/').pop()}/`}>
            <h3>{p.data.title}</h3>
            <p>{p.data.description}</p>
            <p class="meta">{fmt.format(p.data.date)}</p>
          </a>
        </li>
      ))}
    </ul>
  </main>
</Base>
