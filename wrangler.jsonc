{
  // Site static servit prin Cloudflare Workers (static assets). Astro generează site-ul în ./dist (npm run build)
  "name": "vladgriguta-com",
  "compatibility_date": "2026-10-01",
  // Domeniile proprii; zona vladgriguta.com e în același cont Cloudflare, deci DNS-ul se configurează automat la deploy
  "routes": [
    { "pattern": "vladgriguta.com", "custom_domain": true },
    { "pattern": "www.vladgriguta.com", "custom_domain": true }
  ],
  // Rulează build-ul Astro înainte de fiecare deploy, deci nu trebuie setat nimic în dashboard
  "build": { "command": "npm run build" },
  // Cerut de `wrangler preview` (build-urile de preview pentru branch-uri și PR-uri)
  "previews": {},
  // Adresa .workers.dev și adresele de preview pe versiune; fără ele, PR-urile nu primesc link de preview
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
